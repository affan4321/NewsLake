# --- freenewsapi.io ---
NEWS_API_KEY=your_api_key_here
NEWS_API_BASE_URL=https://api.freenewsapi.io/v1
# Articles fetched (with full /v1/details enrichment) per ingestion run.
# 5000 req/day quota; each article costs 1 details call + a share of listing calls.
MAX_ARTICLES_PER_RUN=300

# --- MinIO (local S3-compatible object store) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_ENDPOINT=localhost:9000
MINIO_BUCKET=news-lakehouse

# --- Airflow ---
# Absolute host path to this repo. Airflow's worker talks to the HOST Docker daemon
# (via the mounted socket) to run `docker compose`, so any compose file / build context
# path it uses must be a real host path -- container-internal paths like /opt/project
# mean nothing to the daemon. See README "Airflow + Docker-outside-of-Docker" note.
HOST_PROJECT_DIR="/absolute/path/to/NewsLake"
AIRFLOW_UID=50000
AIRFLOW_FERNET_KEY=generate_with_python_-c_"import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
AIRFLOW_JWT_SECRET=generate_with_python_-c_"import secrets;print(secrets.token_hex(32))"
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=airflow
# Cron expression controlling how often the newslake_pipeline DAG runs (Stage 4).
PIPELINE_SCHEDULE_CRON="0 6 * * *"

# --- PostgreSQL (serving/analytics DB -- separate from Airflow's own metadata DB) ---
# Hosted on Neon (free tier) rather than the local `postgres` service, so the Streamlit
# dashboard can be deployed externally later -- Streamlit Community Cloud can't reach a
# Postgres running in your local Docker. Everything else (MinIO/Spark/Airflow/dbt) stays
# local regardless.
# Use the DIRECT connection host, not the "-pooler" one: the pooled endpoint runs
# PgBouncer in transaction-pooling mode, which hangs Spark's JDBC writer indefinitely on
# its TRUNCATE+batch-INSERT sequence -- confirmed by testing, no error, it just never
# returns. (A pooled connection is fine for Streamlit's own read traffic if you want one
# for that specifically -- just don't use it for the Spark loader or dbt.)
# For local-only development instead, use: POSTGRES_HOST=postgres, drop POSTGRES_SSLMODE,
# and `docker compose up -d postgres`.
POSTGRES_USER=your_neon_user
POSTGRES_PASSWORD=your_neon_password
POSTGRES_DB=your_neon_db
POSTGRES_HOST=ep-your-project.region.aws.neon.tech
POSTGRES_PORT=5432
POSTGRES_SSLMODE=require

# --- Next.js site revalidation ---
# The DAG's last task POSTs here right after a successful run, so the public site's
# cached homepage (revalidate = 3600 in web/src/app/page.tsx) refreshes immediately
# instead of waiting up to an hour -- most noticeable on manual/off-schedule runs.
# Point this at your deployed site (e.g. Vercel URL) once it's live; localhost only
# helps while developing the site locally alongside a local pipeline run.
# REVALIDATE_SECRET must match web/.env.local (local) or the deployment's env vars.
NEXTJS_SITE_URL="https://newslakeoriginal.vercel.app"
REVALIDATE_SECRET="generate_with_python_-c_\"import secrets;print(secrets.token_hex(32))\""
